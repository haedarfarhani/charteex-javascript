{
  "name": "charteex-javascript",
  "version": "0.1.1",
  "description": "Charteex — professional zero-dependency JavaScript charting library (SVG + Canvas, financial charts, indicators)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {},
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "demo": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run build:declarations && vite build --outDir dist/bundle && node scripts/merge-dist.cjs && node scripts/prepare-dist.cjs",
    "build:declarations": "tsc",
    "build:bundle": "vite build --outDir dist/bundle",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "node -e 'console.log(\"Run live benchmark in demo portal\")'",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pack:validate": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "charts",
    "charting",
    "charteex",
    "visualization",
    "svg",
    "canvas",
    "typescript",
    "zero-dependency",
    "candlestick",
    "trading"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.40.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^7.18.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
