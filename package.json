{
  "name": "@smart-chart/core",
  "version": "0.1.0",
  "description": "Professional zero-dependency JavaScript charting library",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "dependencies": {},
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "demo": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build --outDir dist --emptyOutDir && npm run build:declarations && node scripts/prepare-dist.cjs",
    "build:declarations": "tsc",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "node -e 'console.log(\"Run live benchmark in demo portal\")'",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "pack:validate": "npm run build:declarations && node scripts/prepare-dist.cjs && npm pack --pack-destination dist --dry-run"
  },
  "keywords": [
    "charts",
    "charting",
    "visualization",
    "svg",
    "canvas",
    "typescript",
    "zero-dependency"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.40.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^7.18.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
